#!/usr/bin/env bash

set -Eeuo pipefail

VERSION="1.0.0"

input=""
output=""
quality="medium"
overwrite=0
tmpdir=""

usage() {
    cat <<EOF
video2gif - v${VERSION}

A lightweight Bash utility to convert videos into optimized, looping GIFs using FFmpeg and Gifsicle.

Usage:
  video2gif -i <input> -o <output> [-q <quality>] [-y]

Options:
  -i FILE       Input video file
  -o FILE       Output GIF file
  -q QUALITY    GIF quality: high, medium, or low (default: medium)
  -y            Overwrite existing output file
  -h            Show this help message
  -v            Show version

Quality levels:
  high          15 FPS, 640px, 256 colors
  medium        10 FPS, 420px, 160 colors
  low           8 FPS, 340px, 112 colors

Examples:
  video2gif -i input.mp4 -o output.gif
  video2gif -i input.mp4 -o output.gif -q high
  video2gif -i input.mp4 -o output.gif -q medium
  video2gif -i input.mp4 -o output.gif -q low
  video2gif -i input.mp4 -o output.gif -y
EOF
}

die() {
    printf '[-] %s\n' "$*" >&2
    exit 1
}

cleanup() {
    if [[ -n "$tmpdir" && -d "$tmpdir" ]]; then
        rm -rf -- "$tmpdir"
    fi
}

while getopts ":i:o:q:hyv" opt; do
    case "$opt" in
        i)
            input="$OPTARG"
            ;;
        o)
            output="$OPTARG"
            ;;
        q)
            quality="${OPTARG,,}"
            ;;
        y)
            overwrite=1
            ;;
        h)
            usage
            exit 0
            ;;
        v)
            printf 'video2gif v%s\n' "$VERSION"
            exit 0
            ;;
        :)
            die "Option -$OPTARG requires an argument."
            ;;
        \?)
            die "Unknown option: -$OPTARG"
            ;;
    esac
done

shift "$((OPTIND - 1))"

if [[ $# -gt 0 ]]; then
    die "Unexpected argument: $1"
fi

if [[ -z "$input" || -z "$output" ]]; then
    die "Input and output are required. Use -h for help."
fi

if [[ ! -f "$input" || ! -r "$input" ]]; then
    die "Input file does not exist or is not readable: $input"
fi

for cmd in ffmpeg gifsicle mktemp dirname rm mv ln du cut; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        die "Required dependency not found: $cmd"
    fi
done

if [[ "${output,,}" != *.gif ]]; then
    die "Output filename must have a .gif extension."
fi

if [[ -d "$output" ]]; then
    die "Output path is a directory: $output"
fi

if [[ -e "$output" || -L "$output" ]]; then
    if [[ "$input" -ef "$output" ]]; then
        die "Input and output refer to the same file."
    fi

    if (( overwrite == 0 )); then
        die "Output file already exists. Use -y to overwrite it."
    fi
fi

case "$quality" in
    high)
        fps=15
        width=640
        colors=256
        bayer_scale=3
        ;;
    medium)
        fps=10
        width=420
        colors=160
        bayer_scale=4
        ;;
    low)
        fps=8
        width=340
        colors=112
        bayer_scale=4
        ;;
    *)
        die "Invalid quality: $quality. Available: high, medium, low."
        ;;
esac

output_dir="$(dirname -- "$output")"

if [[ ! -d "$output_dir" ]]; then
    die "Output directory does not exist: $output_dir"
fi

if ! tmpdir="$(mktemp -d -- "${output_dir}/.video2gif.XXXXXX")"; then
    die "Failed to create temporary directory."
fi

trap cleanup EXIT

temp_gif="${tmpdir}/temp.gif"
final_gif="${tmpdir}/output.gif"

printf '[*] video2gif v%s\n' "$VERSION"
printf '[*] Input: %s\n' "$input"
printf '[*] Output: %s\n' "$output"
printf '[*] Quality: %s\n' "$quality"
printf '[*] Settings: %s FPS, %spx, %s colors\n' "$fps" "$width" "$colors"

printf '[*] Converting video to GIF...\n'

ffmpeg -hide_banner -nostdin -i "$input" \
    -filter_complex "[0:v]fps=${fps},scale=w='min(${width},iw)':h=-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=${colors}:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=${bayer_scale}:diff_mode=rectangle[gif]" \
    -map "[gif]" \
    -an \
    -loop 0 \
    -y "$temp_gif"

printf '[*] Optimizing GIF...\n'

gifsicle -O3 --no-comments --no-names "$temp_gif" -o "$final_gif"

printf '[*] Saving output...\n'

if (( overwrite )); then
    mv -f -- "$final_gif" "$output"
else
    if ! ln -- "$final_gif" "$output"; then
        die "Failed to save output. The destination may already exist."
    fi
    rm -- "$final_gif"
fi

printf '[+] Conversion completed successfully!\n'
printf '[+] Output: %s\n' "$output"
printf '[+] File size: %s\n' "$(du -h -- "$output" | cut -f1)"
